# ArmorPaint Free Library - plugin configuration
# Easiest way to edit this: Plugins tab -> Free Library -> Settings panel
# (it reads and writes this file for you). Manual editing works too:
# copy this file to data/.env (or ./.env next to the ArmorPaint executable).
# Read once at startup - restart after editing.

# Where downloads are stored (defaults shown)
LIB_ROOT=./FreeLibrary
THUMB_DIR=./.freelib_thumbs

# poly.pizza API key (free, self-service): https://poly.pizza/settings/api
POLY_PIZZA_KEY=

# Sketchfab API token (free): https://sketchfab.com/settings/password
# -> "API tokens" section
SKETCHFAB_TOKEN=
